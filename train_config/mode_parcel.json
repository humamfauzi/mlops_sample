{
    "name": "post_test_log_gboosting",
    "description": "Segment: parcel/courier shipments (MODE=14). Train a dedicated model on this high-volume, low-value segment to reduce error caused by mixing it with air and bulk shipments.",
    "instructions": [
        {
            "type": "data_io",
            "properties": {
                "path": "dataset",
                "file": "cfs_2017",
                "format": "csv",
                "reference": "commodity_flow"
            },
            "call": [
                {
                    "type": "load",
                    "n_rows": 1000000
                }
            ]
        },
        {
            "type": "data_cleaner",
            "properties": {
                "type": "lazy_call",
                "reference": "commodity_flow"
            },
            "call": [
                {
                    "type": "filter_rows",
                    "column": "mode",
                    "operator": "in",
                    "values": [
                        14
                    ]
                },
                {
                    "type": "filter_columns",
                    "columns": [
                        "shipment_weight",
                        "shipment_value",
                        "shipment_distance_route",
                        "naics",
                        "mode",
                        "sctg"
                    ]
                },
                {
                    "type": "drop_na"
                }
            ]
        },
        {
            "type": "data_transformer",
            "properties": {
                "type": "lazy_call",
                "reference": "commodity_flow"
            },
            "call": [
                {
                    "type": "log_transformation",
                    "condition": "replace",
                    "columns": [
                        "shipment_weight",
                        "shipment_value",
                        "shipment_distance_route"
                    ]
                },
                {
                    "type": "one_hot_encoding",
                    "condition": "append_and_remove",
                    "columns": [
                        "naics",
                        "mode",
                        "sctg"
                    ]
                }
            ]
        },
        {
            "type": "model_trainer",
            "properties": {
                "objective": "best_model",
                "random_state": 42,
                "fold": 5,
                "parameter_grid": {
                    "type": "exhaustive"
                },
                "primary_metric": "mae",
                "metrics": [
                    "mae"
                ]
            },
            "call": [
                {
                    "model_type": "gradient_boosting_regressor",
                    "hyperparameters": {
                        "n_estimators": [
                            500
                        ],
                        "learning_rate": [
                            0.1
                        ],
                        "max_depth": [
                            7
                        ],
                        "subsample": [
                            0.8
                        ],
                        "min_samples_leaf": [
                            5
                        ],
                        "random_state": [
                            42
                        ]
                    }
                }
            ]
        },
        {
            "type": "post_test",
            "properties": {
                "path": "dataset",
                "file": "cfs_2017",
                "format": "csv",
                "reference": "commodity_flow"
            },
            "call": [
                {
                    "intent": "measure_outcome_actual_value",
                    "check_against": "random",
                    "n_samples": 100000,
                    "metrics": [
                        "mae"
                    ],
                    "seed": 42
                }
            ]
        }
    ]
}
