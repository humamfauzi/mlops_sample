# Copy this file to .env and adjust as needed.
#
# Everything here is OPTIONAL. Defaults live in config/runtime.json, which both
# the training pipeline and the inference server resolve through
# (see runtime_config.py). Values set here override that file, which is how you
# point a deployment at a different database without editing tracked files.
#
# The only variables that are genuinely environment-specific are the DVC
# credentials, needed to pull the training dataset.

# ------------------------------------------------------------------ serving
# Port the HTTP server binds to. Also read by the Makefile for curl targets.
PORT=8000

# Which experiment the server loads published models from.
# EXPERIMENT_ID=experiment_001

# Which column schema describes the data (see column/cfs2017.py).
# COLUMN_REFERENCE=commodity_flow

# --------------------------------------------------------------- repository
# The registry and the artifact store. Both default to one SQLite file.
# REPOSITORY_DATA=sqlite
# REPOSITORY_DATA_PATH=example.db
# REPOSITORY_OBJECT=sqlite
# REPOSITORY_OBJECT_PATH=example.db

# Point both runtimes at a different runtime config file instead.
# MLOPS_CONFIG=/etc/mlops/runtime.json

# --------------------------------------------------------------------- dvc
# Credentials for the DVC remote holding dataset/cfs_2017.csv
# (s3://humamf-dataset/cfs). Required only to pull or push the dataset.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
