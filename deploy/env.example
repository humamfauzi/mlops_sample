# Deployment overrides for an installed server.
#
# Everything here is OPTIONAL: defaults come from config/runtime.json, which
# both the trainer and the server resolve through (see runtime_config.py).
# Values set here win, so this is how a host points at its own registry
# without editing the tracked config.
#
# Install this file as /opt/mlops/.env with mode 600.

# --------------------------------------------------------------- networking
PORT=8000
# HOST is pinned to 0.0.0.0 by the systemd unit; override it there if needed.

# --------------------------------------------------------------- repository
# Absolute paths: the service runs with WorkingDirectory=/opt/mlops, but being
# explicit avoids surprises if that ever changes.
REPOSITORY_DATA=sqlite
REPOSITORY_DATA_PATH=/opt/mlops/data/example.db
REPOSITORY_OBJECT=sqlite
REPOSITORY_OBJECT_PATH=/opt/mlops/data/example.db

# Which experiment the server publishes models from.
EXPERIMENT_ID=experiment_001

# Which column schema describes the data (see column/cfs2017.py).
COLUMN_REFERENCE=commodity_flow

# Point at a different runtime config file instead of the packaged one.
# MLOPS_CONFIG=/opt/mlops/config/runtime.json
